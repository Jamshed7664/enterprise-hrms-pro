# Copy this file to .env for Docker Compose. Do NOT commit .env.
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_12_PLUS_CHARACTER_PASSWORD
DEMO_ADMIN_EMAIL=admin@hrms.dev
MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ROOT_PASSWORD
DB_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_APP_PASSWORD
# Comma-separated exact allowed frontend URLs (no trailing slash)
CORS_ORIGINS=http://localhost:4200
